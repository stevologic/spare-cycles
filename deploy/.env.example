# Copy to .env and edit. Every value is optional.

# Your pool's hostname (DNS A record -> this droplet). Set it and Caddy gets
# a Let's Encrypt certificate automatically. Leave empty to serve plain HTTP
# on port 80 (fine for trying things out via the droplet IP).
DOMAIN=

# Only needed when the public hostname differs from what reaches the app
# (extra CDN/proxy in front). Behind the bundled Caddy, leave empty.
SPARECYCLES_PUBLIC_URL=

# Optional: live model catalogs in the New-project form. Used ONLY to list
# models — inference always happens on donor nodes.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
